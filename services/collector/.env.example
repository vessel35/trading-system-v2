# Copy to .env and resolve every placeholder from your secret manager or shell.
COLLECTOR_CONFIG_DB_URL=${CONFIG_DB_URL}
COLLECTOR_DATA_DB_URL=${DATA_DB_URL}
COLLECTOR_BINANCE_API_KEY=${BINANCE_API_KEY}
COLLECTOR_BINANCE_API_SECRET=${BINANCE_API_SECRET}

# Optional selector. Leave unset to require exactly one active Binance symbol in config_db.symbols.
# COLLECTOR_SYMBOL=ETH/USDT:USDT
COLLECTOR_EXCHANGE=binance
COLLECTOR_TIMEFRAME=1m
COLLECTOR_FETCH_LIMIT=3
COLLECTOR_POLL_INTERVAL_SECONDS=60
COLLECTOR_POLL_BUFFER_SECONDS=2
COLLECTOR_LOG_LEVEL=INFO
