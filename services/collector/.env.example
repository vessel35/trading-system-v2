# Copy to .env and resolve every placeholder from your secret manager or shell.
# v2-owned Postgres on the docker-compose host port. Replace placeholders from
# an untracked secret source after assigning passwords to the bootstrap roles.
COLLECTOR_CONFIG_DB_URL=postgresql://config_reader:replace-with-v2-config-reader-password@127.0.0.1:55432/config_db
COLLECTOR_DATA_DB_URL=postgresql://data_writer:replace-with-v2-data-writer-password@127.0.0.1:55432/crypto_data
COLLECTOR_BINANCE_API_KEY=replace-with-binance-api-key
COLLECTOR_BINANCE_API_SECRET=replace-with-binance-api-secret

# Optional selector. Leave unset to require exactly one active Binance symbol in config_db.symbols.
# COLLECTOR_SYMBOL=ETH/USDT:USDT
COLLECTOR_EXCHANGE=binance
COLLECTOR_TIMEFRAME=1m
COLLECTOR_FETCH_LIMIT=3
COLLECTOR_POLL_INTERVAL_SECONDS=60
COLLECTOR_POLL_BUFFER_SECONDS=2
COLLECTOR_LOG_LEVEL=INFO
