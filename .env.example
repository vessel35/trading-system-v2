# v2-owned disposable/development TimescaleDB.
# Copy this file to an untracked environment file and replace every
# replace-with-* placeholder from a secret manager. Never reuse v1 credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-v2-admin-password
V2_POSTGRES_PORT=55432

# backtest-service and web-api use one host plus the named v2 databases.
# Set a password on backtest_writer after bootstrap; init SQL contains no secrets.
PGHOST=127.0.0.1
PGPORT=55432
PGUSER=backtest_writer
PGPASSWORD=replace-with-v2-backtest-writer-password
BACKTEST_DB_NAME=backtest_db
CRYPTO_DB_NAME=crypto_data
SIGNAL_DB_NAME=signal_db
WEBAPI_EVIDENCE_ROOT=var/evidence

# Collector roles are intentionally separate from backtest_writer.
COLLECTOR_CONFIG_DB_URL=postgresql://config_reader:replace-with-v2-config-reader-password@127.0.0.1:55432/config_db
COLLECTOR_DATA_DB_URL=postgresql://data_writer:replace-with-v2-data-writer-password@127.0.0.1:55432/crypto_data
COLLECTOR_BINANCE_API_KEY=replace-with-binance-api-key
COLLECTOR_BINANCE_API_SECRET=replace-with-binance-api-secret
